# HERPath AI - Environment Configuration Example
# Copy this file to .env if you wish to customize configuration.
# The core MVP works 100% locally with SQLite and requires NO external API keys.

# Optional AI Assistant key (Optional only - fallback rule-based search works without API key)
# OPENAI_API_KEY=your_optional_api_key_here

# App environment: development | production | demo
APP_ENV=development

# Database path (defaults to data/herpath.db)
DATABASE_PATH=data/herpath.db
